---
import '../styles/global.css';
import { withBase } from '../lib/paths.js';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Practice data science judgment with 25 interactive case investigations on evidence, uncertainty, causal claims, model risk, and calibrated confidence.',
  image = '/social-card.png',
} = Astro.props;

const siteName = 'Data Science Judgment Lab';
const githubUrl = 'https://github.com/stuartjonesstats/data-science-judgment-lab';
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImageUrl = new URL(withBase(image), siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050708" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <GoogleAnalytics />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href={withBase('/')}>Data Science Judgment Lab</a>
        <nav class="nav-links" aria-label="Primary">
          <a href={withBase('/cases/')}>Cases</a>
          <a href={withBase('/finder/')}>Finder</a>
          <a href={withBase('/pathways/')}>Pathways</a>
          <a href={withBase('/diagnostic/')}>Intake</a>
          <a href={withBase('/completion/')}>Profile</a>
          <a href={withBase('/calibration/')}>Calibration</a>
          <a href={withBase('/methods/')}>Methods</a>
          <a href={withBase('/about/')}>About</a>
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-meta">
          <p>Local-first case lab for reasoning from evidence under uncertainty.</p>
          <p>
            Open-source code under MIT. Case content is available for
            noncommercial educational reuse with attribution.
          </p>
        </div>
        <nav class="footer-links" aria-label="Project links">
          <a href={withBase('/cases/')}>Cases</a>
          <a href={withBase('/finder/')}>Finder</a>
          <a href={withBase('/pathways/')}>Pathways</a>
          <a href={withBase('/completion/')}>Profile</a>
          <a href={withBase('/calibration/')}>Calibration</a>
          <a href={withBase('/methods/')}>Methods</a>
          <a href={withBase('/instructor/')}>Instructor</a>
          <a href={withBase('/license/')}>License</a>
          <a href={withBase('/about/')}>About</a>
          <a href={githubUrl}>GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
